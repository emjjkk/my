---
import Layout from "../layouts/Layout.astro";
import { Skull } from "@lucide/astro";

// Import the JSON data
import blogPosts from "../data/blog.json";
---

<Layout>
	<section id="header" class="md:h-[50vh] flex flex-col justify-end pl-4 pr-4 md:pr-0 pt-4 mb-10">
		<h1 class="text-2xl md:text-3xl mb-5">
			I'm <span class="text-white">Emmanuel</span>, a software developer
			currently specializing in full-stack web and app development.
		</h1>
		<p class="text-md mb-5">
			I'm familiar with Javascript- (NextJS, Astro, Remix, etc) and Python
			(Flask, Django) based frameworks for web development. I can also
			build mobile apps with React Native and other things like discord
			bots and chrome extensions.
		</p>
		<div class="flex gap-2">
			<button
				class="text-sm relative overflow-hidden px-3 py-2 rounded-lg
	bg-neutral-950/90 border border-white/10
	text-neutral-300 transition-colors duration-300 group"
			>
				<span
					class="absolute inset-0 bg-white/10 translate-x-[-100%]
		group-hover:translate-x-0 transition-transform duration-300 ease-out"
				></span>
				<span
					class="relative z-10 group-hover:text-white transition-colors duration-300"
				>
					See my projects
				</span>
			</button>

			<button
				class="text-sm relative overflow-hidden px-3 py-2 rounded-lg
	bg-neutral-950/90 border border-white/10
	text-neutral-300 transition-colors duration-300 group"
			>
				<span
					class="absolute inset-0 bg-white/10 translate-x-[-100%]
		group-hover:translate-x-0 transition-transform duration-300 ease-out"
				></span>
				<span
					class="relative z-10 group-hover:text-white transition-colors duration-300"
				>
					Contact Me
				</span>
			</button>
		</div>
	</section>
	<section id="body" class="pl-4 pr-4 md:pr-0">
		<h2 class="text-lg mb-6">Recent blog posts</h2>
		{blogPosts.map((post) => (
			<div class="post mb-6 md:flex gap-3">
				<div class="md:w-[10%]">
					<p class="text-sm">{post.date}</p>
				</div>
				<a href={`/p/${post.slug}`} class="md:w-[90%]">
					<h3 class="text-md mb-1">
						{post.title}
					</h3>
					<p class="text-sm text-neutral-400 line-clamp-3">
						{post.excerpt}
					</p>
				</a>
			</div>
		))}
	</section>
</Layout>