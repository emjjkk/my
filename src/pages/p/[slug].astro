---
import '../../styles/markdown.css';
import Layout from "../../layouts/Layout.astro";
import blogPosts from "../../data/blog.json";
import { marked } from 'marked';
import fs from 'fs';
import path from 'path';

// Tell Astro to pre-render all pages
export const prerender = true;

// Generate static paths
export async function getStaticPaths() {
  return blogPosts
    .filter(post => fs.existsSync(path.resolve('./public/p', `${post.slug}.md`))) // only if markdown exists
    .map(post => ({
      params: { slug: post.slug },
    }));
}

// Get the slug for this page
const { slug } = Astro.params;

// Find post metadata
const postMeta = blogPosts.find(p => p.slug === slug);

if (!postMeta) {
  return Astro.redirect('/404');
}

// Read markdown at build time
let renderedContent = "<p>Failed to load post content.</p>";

try {
  const filePath = path.resolve('./public/p', `${slug}.md`);
  const markdown = fs.readFileSync(filePath, 'utf-8');
  renderedContent = marked.parse(markdown);
} catch (err) {
  console.error('Error reading markdown:', err);
}
---

<Astro.head>
  <title>{postMeta.title} | @emjjkk</title>
  <meta name="description" content={postMeta.excerpt || postMeta.title} />
  <link rel="canonical" href={`https://emjjkk.tech/p/${postMeta.slug}`} />

  <!-- Open Graph -->
  <meta property="og:title" content={postMeta.title} />
  <meta property="og:description" content={postMeta.excerpt || postMeta.title} />
  <meta property="og:image" content={postMeta.image} />
  <meta property="og:url" content={`https://emjjkk.tech/p/${postMeta.slug}`} />
  <meta property="og:type" content="article" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={postMeta.title} />
  <meta name="twitter:description" content={postMeta.excerpt || postMeta.title} />
  <meta name="twitter:image" content={postMeta.image} />
</Astro.head>

<Layout>
  <section id="header" class="md:h-[50vh] flex flex-col justify-end pl-4 pr-4 md:pr-0 pt-4 mb-5">
    <a href="/" class="text-sm text-blue-500 hover:text-blue-600 mb-2 inline-block">
      ← Back to home
    </a>
    <h1 class="text-2xl md:text-3xl my-2">{postMeta.title}</h1>
    <div class="flex items-center gap-3 text-sm text-neutral-500">
      <span>{postMeta.date}</span>
      <span>•</span>
      <span>{postMeta.readTime}</span>
    </div>
  </section>
  <section id="body" class="pl-4 pr-4 md:pr-0 md:pb-6">
    <main class="min-h-screen">
      <article class="prose prose-invert max-w-none blog-content">
        <div set:html={renderedContent} />
      </article>
    </main>
  </section>
</Layout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/nord.min.css">
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script is:inline>
	hljs.highlightAll();
</script>

<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": postMeta.title,
  "author": {
    "@type": "Person",
    "name": "@emjjkk"
  },
  "datePublished": postMeta.date,
  "image": postMeta.image,
  "url": `https://emjjkk.tech/p/${postMeta.slug}`
})}
</script>


<style is:global>
	pre {
		background: black !important;
		border-radius: 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 1.5rem !important;
		margin: 1.5rem 0;
		max-height: 400px;
		overflow-y: auto;
		overflow-x: auto;
	}
	pre code {
		background: transparent !important;
		padding: 0 !important;
		border-radius: 0;
		border: none;
	}
	:not(pre) > code {
		background: rgba(255, 255, 255, 0.1);
		padding: 0.2rem 0.4rem;
		border-radius: 0.375rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.875em;
	}
</style>
