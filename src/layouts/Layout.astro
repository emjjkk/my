---
import "../styles/global.css";

import Navigation from "../components/navigation.astro";
import RSidebar from "../components/rsidebar.astro";
import SketchDecorations from "../components/SketchDecorations.astro";

// Accept SEO props
const {
  title = "Emmanuel Alabi (@emjjkk) - Software Developer",
  description = "Personal blog of Emmanuel Alabi, software developer.",
  url = "https://emjjkk.tech",
  image = "/default-og-image.png",
} = Astro.props;
---

<!doctype html>
<html lang="en" style="background:#000;">
  <head>
    <!-- Prevent theme flash: set theme before page renders and set html background inline -->
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
          var bg = theme === 'dark' ? '#000000' : '#f8fafc';
          document.documentElement.style.background = bg;
          document.body && (document.body.style.background = bg);
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- SEO Meta -->
    <meta name="description" content={description} />
    <meta name="author" content="Emmanuel Alabi" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <style>
      @media (max-width: 1024px) {
        body {
          padding-bottom: 80px; /* Space for fixed bottom nav */
        }
      }
    </style>
  </head>
  <body class="font-body min-h-screen">
    <!-- Loading overlay (visible by default to mask initial flash) -->
    <div id="loading-overlay" aria-busy="true" style="position:fixed;z-index:9999;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;opacity:1;pointer-events:auto;transition:opacity 0.3s;">
      <div style="width:3rem;height:3rem;border:4px solid var(--muted);border-top:4px solid var(--text);border-radius:50%;animation:spin 1s linear infinite;"></div>
    </div>
    <style>
      @keyframes spin { 100% { transform: rotate(360deg); } }
      #loading-overlay[aria-busy="true"] { display: flex; opacity: 1; }
      #loading-overlay { opacity: 0; pointer-events: none; }
    </style>
    <div class="relative h-screen overflow-hidden max-w-[1366px] mx-auto">
      <SketchDecorations />
      <!-- Main Content -->
      <main
        class="relative z-10 surface h-screen flex flex-col lg:flex-row gap-4 max-w-8xl mx-auto"
      >
        <!-- Desktop Navigation -->
        <div class="hidden lg:block lg:w-[28%] border-r theme-border">
          <Navigation />
        </div>

        <!-- Main Content Area -->
        <div
          class="flex flex-1 overflow-y-auto hide-scrollbar flex-col lg:flex-row h"
        >
          <div class="w-full lg:w-[60%]">
            <slot />
          </div>
          <div class="w-full lg:w-[40%] p-4 lg:sticky lg:top-[-55vh]">
            <RSidebar />
          </div>
        </div>

        <!-- Mobile Navigation -->
        <nav
          class="fixed bottom-0 left-0 right-0 z-50 nav-bg backdrop-blur-sm border-t theme-border lg:hidden"
        >
          <div class="flex justify-around items-center h-15 px-4">
            <Navigation />
          </div>
        </nav>
      </main>
    </div>
    <script>
      // Theme toggle (keep for manual switching)
      // @ts-ignore
      window["toggleTheme"] = function () {
        const current = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        // Update background color immediately
        var bg = next === 'dark' ? '#000000' : '#f8fafc';
        document.documentElement.style.background = bg;
        document.body && (document.body.style.background = bg);
      };
      // Loading overlay for navigation + initial load
      if (typeof window !== 'undefined') {
        let overlay = document.getElementById('loading-overlay');
        // Helper to hide overlay
        function hideOverlay() {
          if (!overlay) return;
          overlay.setAttribute('aria-busy', 'false');
          overlay.style.opacity = '0';
          overlay.style.pointerEvents = 'none';
        }

        // Sync overlay background with the inline background set earlier
        try {
          var bgFromHtml = document.documentElement.style.background;
          if (overlay && bgFromHtml) overlay.style.background = bgFromHtml;
        } catch (e) {}

        // Hide overlay once the initial DOM is ready
        document.addEventListener('DOMContentLoaded', () => {
          // small delay to ensure paints complete
          setTimeout(hideOverlay, 80);
        });

        if (overlay) {
          // Show overlay on navigation start
          window.addEventListener('astro:before-navigate', () => {
            overlay.setAttribute('aria-busy', 'true');
            overlay.style.opacity = '1';
            overlay.style.pointerEvents = 'auto';
            // ensure background matches current html background
            try { overlay.style.background = document.documentElement.style.background; } catch (e) {}
          });
          // Hide overlay on navigation end
          window.addEventListener('astro:after-navigate', () => {
            setTimeout(hideOverlay, 80);
          });
        }
      }
    </script>
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="5a665f32-69be-40cf-abea-7923b603a548"></script>
  </body>
</html>
