<div aria-hidden="true" class="sketch-decorations">
  <svg class="sketch-decorations__doodle sketch-decorations__doodle--top-left" viewBox="0 0 160 96" fill="none">
    <path d="M14 56c24-32 55-38 86-21 17 9 33 10 46 3" />
    <path d="M88 14l6 14m-6-14-12 8m16 6-3 12" />
  </svg>

  <div class="sketch-decorations__note sketch-decorations__note--top-right">
    <span class="sketch-decorations__note-arrow" aria-hidden="true"></span>
    <span class="sketch-decorations__note-text">tiny margin thought</span>
  </div>

  <svg class="sketch-decorations__doodle sketch-decorations__doodle--bottom-right" viewBox="0 0 180 112" fill="none">
    <path d="M18 67c19-23 41-29 65-18 18 8 36 9 55 2" />
    <path d="M129 35c6 10 5 22-3 31m3-31-15 1" />
    <circle cx="28" cy="67" r="3.2" />
    <circle cx="137" cy="34" r="2.8" />
  </svg>
</div>

<style>
  .sketch-decorations {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .sketch-decorations__doodle {
    position: absolute;
    stroke: color-mix(in srgb, var(--text) 28%, transparent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.45;
  }

  .sketch-decorations__doodle--top-left {
    top: 1rem;
    left: 0.5rem;
    width: 7.5rem;
    transform: rotate(-10deg);
  }

  .sketch-decorations__doodle--bottom-right {
    right: 0.5rem;
    bottom: 1.2rem;
    width: 8.75rem;
    transform: rotate(8deg);
  }

  .sketch-decorations__note {
    position: absolute;
    right: 1rem;
    top: 4.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transform: rotate(4deg);
    opacity: 0.88;
  }

  .sketch-decorations__note-text {
    padding: 0.2rem 0.55rem 0.3rem;
    border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 84%, var(--text) 4%);
    color: var(--text);
    font-family: "Fraunces", serif;
    font-size: 0.75rem;
    font-style: italic;
    line-height: 1;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--text) 8%, transparent);
  }

  .sketch-decorations__note-arrow {
    position: relative;
    width: 1.2rem;
    height: 0;
    border-top: 2px solid color-mix(in srgb, var(--text) 55%, transparent);
    transform: rotate(-18deg);
  }

  .sketch-decorations__note-arrow::after {
    content: "↖";
    position: absolute;
    right: -0.05rem;
    top: -1rem;
    color: color-mix(in srgb, var(--text) 55%, transparent);
    font-size: 0.95rem;
    line-height: 1;
    transform: rotate(-10deg);
  }
</style>