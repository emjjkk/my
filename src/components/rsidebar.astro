---

import { ArrowRight, Sparkles, } from "@lucide/astro";
---

<div class="relative">
    <div class="hidden md:block h-[50vh] mb-10"></div>
    <div class="md:px-6 sticky top-5">
        <div class="relative mb-4">
            <div class="rounded-xl card border-[1.5px] border-black/20 dark:border-white/20 p-4 flex flex-col gap-3">
                <div class="flex items-center gap-2">
                    <img
                        src="https://avatars.githubusercontent.com/u/49512755?v=4"
                        alt="Profile"
                        class="w-12 h-12 rounded-full object-cover avatar-border"
                    />
                    <div>
                        <p class="text-sm font-medium theme-text">
                            Emmanuel Alabi (@emjjkk)
                        </p>
                        <p class="text-xs muted">
                            Software dev, college student
                        </p>
                    </div>
                </div>

                <p class="text-xs muted leading-relaxed">
                    I'm a software developer building full-stack web applications with a focus on performance and optimization. If I'm not coding, I'm probably being your toxic ranked teammate, making tiktok edits, or doing community management duties.
                </p>

                <p class="text-sm font-medium theme-text">Subscribe, maybe?</p>

                <p class="text-xs muted leading-relaxed">
                    Occasional drops. UI ideas, dev notes, and experiments.
                </p>

                <a
                    href="https://gumroad.com/emjjkk"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mb-1 inline-flex items-center justify-between gap-2 rounded-lg btn px-3 py-2 text-xs transition"
                >
                    <span>Subscribe</span>
                    <ArrowRight size={14} />
                </a>

                <div class="flex gap-3 pt-1">
                   <a href="https://discord.com/users/1100072616317952040"><i class="fa-brands fa-discord" class="muted hover:theme-text transition"></i></a>
                   <a href="https://github.com/emjjkk"><i class="fa-brands fa-github" class="muted hover:theme-text transition"></i></a>
                   <a href="https://instagram.com/e.mjjkk"><i class="fa-brands fa-instagram" class="muted hover:theme-text transition"></i></a>
                   <a href="https://linkedin.com/in/emjjkk"><i class="fa-brands fa-linkedin" class="muted hover:theme-text transition"></i></a>
                </div>
            </div>
            </div>
        <div
            class="w-full rounded-xl card border-[1.5px] border-black/20 dark:border-white/20 p-4 flex flex-col gap-3"
        >
            <div class="flex items-center gap-2">
                <Sparkles size={14} class="muted" />
                    <p class="text-sm font-medium theme-text">Open for work</p>
            </div>

            <div class="flex flex-col gap-1">
                     <p class="text-xs muted leading-relaxed">
                   Custom dev services including web development, stream overlays, and Discord/Telegram bots. Fast, clean, and tailored to your needs.
                </p>
            </div>

            <a
                href="https://work.emjjkk.tech"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-between gap-2 rounded-lg btn px-3 py-2 text-xs transition"
            >
                <span>Learn More</span>
                <ArrowRight size={14} />
            </a>
        </div>
        <p class="text-xs pt-3 pb-1">Some things are best viewed without a rulebook</p>
        <p class="text-xs pb-3 muted">&copy;2025 Emmanuel A. Made with Astro & TailwindCSS</p>
    </div>
</div>
